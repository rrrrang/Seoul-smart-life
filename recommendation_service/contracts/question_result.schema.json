      },
      "required": [
        "status",
        "chunks"
      ],
      "title": "EvidenceResult",
      "type": "object"
    },
    "ExcludedRegion": {
      "additionalProperties": false,
      "properties": {
        "region_code": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Region Code",
          "type": "string"
        },
        "reason": {
          "enum": [
            "missing_scores",
            "constraint_mismatch"
          ],
          "title": "Reason",
          "type": "string"
        },
        "domains": {
          "items": {
            "enum": [
              "economy",
              "energy",
              "comfort",
              "health",
              "safety"
            ],
            "type": "string"
          },
