    "DomainInsight": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "enum": [
            "economy",
            "energy",
            "comfort",
            "health",
            "safety"
          ],
          "title": "Domain",
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "contribution": {
          "minimum": 0,
          "title": "Contribution",
          "type": "number"
        }
      },
      "required": [
        "domain",
        "score",
        "contribution"
      ],
      "title": "DomainInsight",
      "type": "object"
