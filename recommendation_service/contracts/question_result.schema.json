          "type": "array"
        },
        "unsupported_conditions": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Conditions",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "needs_confirmation": {
          "default": true,
          "title": "Needs Confirmation",
          "type": "boolean"
