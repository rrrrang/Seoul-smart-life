          "title": "Extraction Status",
          "type": "string"
        },
        "weight_source": {
          "default": "default",
          "enum": [
            "explicit",
            "priority",
            "default",
            "fallback"
          ],
          "title": "Weight Source",
          "type": "string"
        }
      },
