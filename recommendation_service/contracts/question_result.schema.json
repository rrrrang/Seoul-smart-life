      "type": "object"
    },
    "ExtractedPreferences": {
      "additionalProperties": false,
      "properties": {
        "weights": {
          "$ref": "#/$defs/Weights"
        },
        "top_k": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "min_scores": {
          "$ref": "#/$defs/CategoryScores"
        },
        "priority_domains": {
          "items": {
            "enum": [
              "economy",
              "energy",
              "comfort",
              "health",
              "safety"
