    "EvidenceChunk": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "document_title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Document Title",
          "type": "string"
        },
        "reference_year": {
          "maximum": 2100,
          "minimum": 1900,
          "title": "Reference Year",
          "type": "integer"
        },
        "region_code": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Code"
        }
      },
      "required": [
        "chunk_id",
        "text",
        "source",
        "document_title",
        "reference_year"
      ],
      "title": "EvidenceChunk",
      "type": "object"
    },
    "EvidenceResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "found",
            "no_evidence"
          ],
          "title": "Status",
          "type": "string"
